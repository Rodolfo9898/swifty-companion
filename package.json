{
  "name": "swifty-companion",
  "version": "1.0.0",
  "main": "index.ts",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --clear",
    "launch:web": "expo start --web --clear",
    "launch:web:https": "expo start --web --https --localhost --clear",
    "serve:web": "node scripts/serve-web.js",
    "serve:web:localhost": "node scripts/serve-web-localhost.js",
    "launch:web:localhost": "npm run build:web && npm run serve:web:localhost",
    "build:web": "EXPO_NO_CLIENT_SECRET=1 expo export --platform web"
  },
  "dependencies": {
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/native": "^7.1.26",
    "@react-navigation/native-stack": "^7.9.0",
    "dotenv": "^17.2.3",
    "expo": "~54.0.30",
    "expo-auth-session": "~7.0.10",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.21",
    "expo-secure-store": "~15.0.8",
    "expo-sqlite": "~16.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "@types/react-native": "^0.72.8",
    "babel-preset-expo": "^54.0.9",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "postcss": "8.5.10",
    "uuid": "14.0.0"
  },
  "private": true
}
